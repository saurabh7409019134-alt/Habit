# ============================================================================
# KeepIt Habit Tracker — Safe Environment Template (.env.example)
# ============================================================================
# Copy this file to `.env` for local development:
#   cp .env.example .env
#
# SECURITY WARNING:
# - Never put real API keys, passwords, or service-role keys in `.env.example`.
# - Never commit `.env` or any `.env.*` file containing real credentials.
# - Store production credentials in your deployment platform's Secret Manager
#   (e.g., Vercel Environment Variables, GitHub Actions Secrets, Supabase Vault).
# ============================================================================

# --- Gmail / SMTP Configuration (Server-only, required for OTP emails) ---
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-google-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# --- Supabase Configuration ---
# Public project URL and publishable/anon key (safe with RLS enabled)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Privileged backend service-role key (Optional, SERVER-ONLY — never expose in frontend!)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Local Development Server ---
PORT=3000
